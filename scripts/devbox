#!/usr/bin/env bash
#
# devbox — laptop-side wrapper for the RO Compass devbox VM.
#
#   devbox <name>       attach to tmux session <name> (creates it if missing);
#                       starts the VM first if it's stopped
#   devbox cc <name>    same, but iTerm2-native (tmux -CC control mode)
#   devbox ls           list tmux sessions on the box
#   devbox ssh          plain shell, no tmux
#   devbox kill <name>  kill a tmux session
#   devbox up|down      start / stop the VM
#   devbox status       VM state (RUNNING / TERMINATED / ...)
#   devbox sync         two-way sync of the repo's gitignored docs/ files with the box
set -euo pipefail

PROJECT="app-dev-464512"
ZONE="us-central1-a"
INSTANCE="ro-dev-devbox-hfritz"
HOST="ro-devbox" # ~/.ssh/config entry (IAP ProxyCommand)

STATE_ROOT="$HOME/.devbox-sync"

usage() { sed -n '3,13p' "$0"; }

tmp=""
lock_held=""

cleanup() {
  if [ -n "$tmp" ]; then rm -rf "$tmp"; fi
  if [ -n "$lock_held" ]; then rm -rf "$state/lock"; fi
}

# Sets $root and $remote for the primary checkout of the current repo, or exits.
resolve_repo() {
  local common repo
  common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || {
    echo "devbox sync: run from inside a git repo" >&2
    exit 1
  }
  root="$(dirname "$common")"
  [ -d "$root/docs" ] || {
    echo "devbox sync: no docs/ in $root" >&2
    exit 1
  }
  repo="$(basename "$root")"
  remote="$(ssh "$HOST" "ls -d ~/'$repo' ~/Projects/'$repo' ~/Misc/'$repo' 2>/dev/null | head -1")"
  [ -n "$remote" ] || {
    echo "devbox sync: no '$repo' checkout found on the box" >&2
    exit 1
  }
}

# Sets $state, takes its lock, and checks it belongs to $remote, or exits.
open_state() {
  local lock pid recorded
  state="$STATE_ROOT/$(basename "$root")"
  lock="$state/lock"
  mkdir -p "$state"
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM HUP
  if ! mkdir "$lock" 2>/dev/null; then
    pid="$(cat "$lock/pid" 2>/dev/null || true)"
    if [ -z "$pid" ] || kill -0 "$pid" 2>/dev/null; then
      echo "devbox sync: another sync (pid ${pid:-unknown}) holds $lock" >&2
      exit 1
    fi
    echo "devbox sync: reclaiming stale lock from dead pid $pid" >&2
    rm -rf "$lock"
    mkdir "$lock" 2>/dev/null || {
      echo "devbox sync: another sync holds $lock" >&2
      exit 1
    }
  fi
  lock_held=1
  echo $$ >"$lock/pid"
  if [ ! -d "$state/base" ] && [ -d "$state/base.old" ]; then
    mv "$state/base.old" "$state/base"
  fi
  mkdir -p "$state/base" "$state/trash"
  if [ -f "$state/remote" ]; then
    recorded="$(cat "$state/remote")"
    [ "$recorded" = "$remote" ] || {
      echo "devbox sync: $state was synced with $recorded, but the box checkout is now $remote; remove $state to start over" >&2
      exit 1
    }
  fi
}

# Snapshots the in-scope laptop files into $tmp/L and VM files into $tmp/V, and
# writes the in-scope union of laptop, VM and $state/base paths to $tmp/paths.
collect() {
  local p
  local -A cand=() vm_tracked=()
  skipped=()
  mkdir -p "$tmp/raw" "$tmp/L" "$tmp/V"
  : >"$tmp/candidates" >"$tmp/L.list" >"$tmp/V.list" >"$tmp/skipped"

  git -C "$root" ls-files -z --others --ignored --exclude-standard -- docs >"$tmp/laptop.list"
  ssh "$HOST" "cd '$remote' && git ls-files -z -- docs" >"$tmp/vm-tracked.list"
  # --ignore-failed-read: a live VM session may delete a file between listing and tar.
  ssh "$HOST" "set -o pipefail; cd '$remote' && git ls-files -z --others -- docs |
    tar -cf - --null --no-recursion --ignore-failed-read -T -" |
    tar -C "$tmp/raw" -xf - --no-xattrs --no-mac-metadata --no-fflags

  while IFS= read -r -d '' p; do vm_tracked[$p]=1; done <"$tmp/vm-tracked.list"
  while IFS= read -r -d '' p; do cand[$p]=1; done <"$tmp/laptop.list"
  if [ -d "$tmp/raw/docs" ]; then
    (cd "$tmp/raw" && find docs \( -type f -o -type l \) -print0) >"$tmp/vm.list"
    while IFS= read -r -d '' p; do cand[$p]=1; done <"$tmp/vm.list"
  fi
  if [ -d "$state/base/docs" ]; then
    (cd "$state/base" && find docs -type f -print0) >"$tmp/base.list"
    while IFS= read -r -d '' p; do cand[$p]=1; done <"$tmp/base.list"
  fi

  for p in "${!cand[@]}"; do
    case "$p" in
      *$'\n'*)
        skipped+=("$p")
        printf '%s\0' "$p" >>"$tmp/skipped"
        printf 'devbox sync: skipping name with a newline: %q\n' "$p" >&2
        continue
        ;;
      *.vm | */._* | */.DS_Store) continue ;;
    esac
    [ -z "${vm_tracked[$p]:-}" ] || continue
    [ -L "$root/$p" ] || [ -L "$tmp/raw/$p" ] || printf '%s\0' "$p" >>"$tmp/candidates"
  done
  git -C "$root" check-ignore --stdin -z <"$tmp/candidates" >"$tmp/paths" || [ $? -eq 1 ]

  while IFS= read -r -d '' p; do
    [ ! -f "$root/$p" ] || printf '%s\0' "$p" >>"$tmp/L.list"
    [ ! -f "$tmp/raw/$p" ] || printf '%s\0' "$p" >>"$tmp/V.list"
  done <"$tmp/paths"
  tar -C "$root" -cf - --no-xattrs --no-mac-metadata --no-fflags --null -T "$tmp/L.list" | tar -C "$tmp/L" -xf -
  tar -C "$tmp/raw" -cf - --null -T "$tmp/V.list" | tar -C "$tmp/V" -xf -
  rm -rf "$tmp/raw"
}

vm_status() {
  gcloud compute instances describe "$INSTANCE" \
    --project="$PROJECT" --zone="$ZONE" --format='value(status)'
}

ensure_running() {
  local s
  s="$(vm_status)"
  if [ "$s" != "RUNNING" ]; then
    echo "devbox is ${s} — starting…" >&2
    gcloud compute instances start "$INSTANCE" --project="$PROJECT" --zone="$ZONE" >&2
    echo "waiting for SSH…" >&2
    until ssh -o ConnectTimeout=5 "$HOST" true 2>/dev/null; do sleep 5; done
  fi
}

cmd="${1:-}"
case "$cmd" in
  "" | -h | --help) usage ;;
  up) gcloud compute instances start "$INSTANCE" --project="$PROJECT" --zone="$ZONE" ;;
  down) gcloud compute instances stop "$INSTANCE" --project="$PROJECT" --zone="$ZONE" ;;
  status) vm_status ;;
  ls)
    ensure_running
    ssh "$HOST" 'tmux ls 2>/dev/null || echo "no sessions"'
    ;;
  ssh)
    ensure_running
    ssh -t "$HOST"
    ;;
  kill)
    ssh "$HOST" "tmux kill-session -t '${2:?usage: devbox kill <name>}'"
    ;;
  sync)
    ensure_running
    resolve_repo
    open_state
    export COPYFILE_DISABLE=1
    tmp="$(mktemp -d)"
    collect
    echo "devbox sync: not yet implemented" >&2
    exit 1
    ;;
  cc)
    ensure_running
    ssh -t "$HOST" "tmux -CC new -As '${2:?usage: devbox cc <name>}'"
    ;;
  *)
    ensure_running
    ssh -t "$HOST" "tmux new -As '$cmd'"
    ;;
esac
