#!/usr/bin/env bash
#
# devbox — laptop-side wrapper for the RO Compass devbox VM.
#
#   devbox <name>       attach to tmux session <name> (creates it if missing);
#                       starts the VM first if it's stopped
#   devbox cc <name>    same, but iTerm2-native (tmux -CC control mode)
#   devbox ls           list tmux sessions on the box
#   devbox ssh          plain shell, no tmux
#   devbox kill <name>  kill a tmux session
#   devbox up|down      start / stop the VM
#   devbox status       VM state (RUNNING / TERMINATED / ...)
#   devbox sync         two-way sync of the repo's gitignored docs/ files with the box
set -euo pipefail

PROJECT="app-dev-464512"
ZONE="us-central1-a"
INSTANCE="ro-dev-devbox-hfritz"
HOST="ro-devbox" # ~/.ssh/config entry (IAP ProxyCommand)

STATE_ROOT="$HOME/.devbox-sync"

usage() { sed -n '3,13p' "$0"; }

tmp=""
lock_held=""

cleanup() {
  if [ -n "$tmp" ]; then rm -rf "$tmp"; fi
  if [ -n "$lock_held" ]; then rm -rf "$state/lock"; fi
}

# Sets $root and $remote for the primary checkout of the current repo, or exits.
resolve_repo() {
  local common repo
  common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || {
    echo "devbox sync: run from inside a git repo" >&2
    exit 1
  }
  root="$(dirname "$common")"
  [ -d "$root/docs" ] || {
    echo "devbox sync: no docs/ in $root" >&2
    exit 1
  }
  repo="$(basename "$root")"
  remote="$(ssh "$HOST" "ls -d ~/'$repo' ~/Projects/'$repo' ~/Misc/'$repo' 2>/dev/null | head -1")"
  [ -n "$remote" ] || {
    echo "devbox sync: no '$repo' checkout found on the box" >&2
    exit 1
  }
}

# Sets $state, takes its lock, and checks it belongs to $remote, or exits.
open_state() {
  local lock pid recorded
  state="$STATE_ROOT/$(basename "$root")"
  lock="$state/lock"
  mkdir -p "$state"
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM HUP
  if ! mkdir "$lock" 2>/dev/null; then
    pid="$(cat "$lock/pid" 2>/dev/null || true)"
    if [ -z "$pid" ] || kill -0 "$pid" 2>/dev/null; then
      echo "devbox sync: another sync (pid ${pid:-unknown}) holds $lock" >&2
      exit 1
    fi
    echo "devbox sync: reclaiming stale lock from dead pid $pid" >&2
    rm -rf "$lock"
    mkdir "$lock" 2>/dev/null || {
      echo "devbox sync: another sync holds $lock" >&2
      exit 1
    }
  fi
  lock_held=1
  echo $$ >"$lock/pid"
  if [ ! -d "$state/base" ] && [ -d "$state/base.old" ]; then
    mv "$state/base.old" "$state/base"
  fi
  mkdir -p "$state/base" "$state/trash"
  if [ -f "$state/remote" ]; then
    recorded="$(cat "$state/remote")"
    [ "$recorded" = "$remote" ] || {
      echo "devbox sync: $state was synced with $recorded, but the box checkout is now $remote; remove $state to start over" >&2
      exit 1
    }
  fi
}

vm_status() {
  gcloud compute instances describe "$INSTANCE" \
    --project="$PROJECT" --zone="$ZONE" --format='value(status)'
}

ensure_running() {
  local s
  s="$(vm_status)"
  if [ "$s" != "RUNNING" ]; then
    echo "devbox is ${s} — starting…" >&2
    gcloud compute instances start "$INSTANCE" --project="$PROJECT" --zone="$ZONE" >&2
    echo "waiting for SSH…" >&2
    until ssh -o ConnectTimeout=5 "$HOST" true 2>/dev/null; do sleep 5; done
  fi
}

cmd="${1:-}"
case "$cmd" in
  "" | -h | --help) usage ;;
  up) gcloud compute instances start "$INSTANCE" --project="$PROJECT" --zone="$ZONE" ;;
  down) gcloud compute instances stop "$INSTANCE" --project="$PROJECT" --zone="$ZONE" ;;
  status) vm_status ;;
  ls)
    ensure_running
    ssh "$HOST" 'tmux ls 2>/dev/null || echo "no sessions"'
    ;;
  ssh)
    ensure_running
    ssh -t "$HOST"
    ;;
  kill)
    ssh "$HOST" "tmux kill-session -t '${2:?usage: devbox kill <name>}'"
    ;;
  sync)
    ensure_running
    resolve_repo
    open_state
    echo "devbox sync: not yet implemented" >&2
    exit 1
    ;;
  cc)
    ensure_running
    ssh -t "$HOST" "tmux -CC new -As '${2:?usage: devbox cc <name>}'"
    ;;
  *)
    ensure_running
    ssh -t "$HOST" "tmux new -As '$cmd'"
    ;;
esac
